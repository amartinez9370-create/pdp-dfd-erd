        <mxCell id="15B0TtC8MjlmT24uG52t-9" __o="17" parent="f14l-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#E6E6E6;" value="&lt;b&gt;SYSTEM&lt;/b&gt; confirms the request, issues the reference code, rates the no-show risk,&lt;div&gt;and sends the notifications.&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="380" x="800" y="85" as="geometry" />
        </mxCell>
        <mxCell id="15B0TtC8MjlmT24uG52t-10" __o="17" parent="f14l-1" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#F7F7F7;" value="Does the visit take place?" vertex="1">
