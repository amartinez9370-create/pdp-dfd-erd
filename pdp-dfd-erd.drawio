        <mxCell id="15B0TtC8MjlmT24uG52t-4" __o="17" parent="f14l-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#E6E6E6;" value="&lt;b&gt;SYSTEM&lt;/b&gt; saves the request as pending and sends the notifications." vertex="1">
          <mxGeometry height="66" width="380" x="287" y="407" as="geometry" />
        </mxCell>
        <mxCell id="15B0TtC8MjlmT24uG52t-5" __o="17" parent="f14l-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#FFFFFF;" value="&lt;b&gt;STAFF or ADMIN&lt;/b&gt; assigns a date, time, and dentist to the request. A &lt;b&gt;DENTIST&lt;/b&gt; may assign a request that names them." vertex="1">
          <mxGeometry height="88" width="380" x="287" y="497" as="geometry" />
        </mxCell>
        <mxCell id="15B0TtC8MjlmT24uG52t-6" __o="17" parent="f14l-1" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#F7F7F7;" value="Is the time free for the dentist?" vertex="1">
          <mxGeometry height="92" width="360" x="297" y="609" as="geometry" />
        </mxCell>
        <mxCell id="15B0TtC8MjlmT24uG52t-7" __o="17" parent="f14l-1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#FFFFFF;" value="A" vertex="1">
          <mxGeometry height="40" width="40" x="457" y="725" as="geometry" />
        </mxCell>
        <mxCell id="15B0TtC8MjlmT24uG52t-8" __o="17" parent="f14l-1" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#FFFFFF;" value="A" vertex="1">
