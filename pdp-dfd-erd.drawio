        <mxCell id="15B0TtC8MjlmT24uG52t-11" __o="17" parent="f14l-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#FFFFFF;" value="&lt;b&gt;DENTIST&lt;/b&gt; reviews the medical history and&lt;div&gt;records the odontogram, treatment,&lt;/div&gt;&lt;div&gt;prescriptions,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;and X-ray images.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="800" y="313" as="geometry" />
        </mxCell>
        <mxCell id="15B0TtC8MjlmT24uG52t-12" __o="17" parent="f14l-1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=20;align=center;verticalAlign=middle;fillColor=#FFFFFF;" value="&lt;b&gt;STAFF or ADMIN&lt;/b&gt; records the charges and payments." vertex="1">
